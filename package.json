{
  "name": "personal-crm",
  "version": "1.116.0",
  "private": true,
  "scripts": {
    "install-dependencies": "npm i",
    "dev": "next dev",
    "prebuild": "tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "signin:code-assistant": "aws sso login --profile nxsflow-staging",
    "sandbox": "npx ampx sandbox --profile impulso --once",
    "sandbox:debug": "npx ampx sandbox --profile impulso --debug",
    "sandbox:logs": "npx ampx sandbox --profile impulso --stream-function-logs",
    "import-data-dev": "cd scripts && node start-import -env dev",
    "import-data-staging": "cd scripts && node start-import -env staging",
    "import-data-prod": "cd scripts && node start-import -env prod",
    "export-data-dev": "cd scripts && node export-data -env dev",
    "export-data-staging": "cd scripts && node export-data -env staging",
    "export-data-prod": "cd scripts && node export-data -env prod",
    "create-code": "npx ampx generate graphql-client-code --out amplify/graphql-code --profile impulso"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "dependencies": {
